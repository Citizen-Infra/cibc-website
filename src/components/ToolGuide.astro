---
import { availability, projects, siteCopy, toolExamples } from '../data/projects.js';
---
<section class="tool-guide wrap" aria-label={siteCopy.guideLabel} data-tool-guide>
  <nav class="tool-index" aria-label="Choose a tool example">
    {toolExamples.map((example) => (
      <a id={`task-${example.project}`} class="tool-choice" href={`#example-${example.project}`}>
        <strong>{example.task}</strong>
        <span>{projects.find((project) => project.id === example.project)?.name}</span>
      </a>
    ))}
  </nav>
  <div class="tool-examples">
    {toolExamples.map((example) => {
      const project = projects.find((project) => project.id === example.project)!;
      return (
        <section id={`example-${example.project}`} class="tool-panel" aria-labelledby={`heading-${example.project}`}>
          <div class="tool-heading">
            <h2 id={`heading-${example.project}`}>{example.title}</h2>
            <a class="tool-name" href={project.href}>{project.name}</a>
          </div>
          {example.project === 'avails' && (
            <figure class="availability-example">
              <div class="table-scroll" role="region" tabindex="0" aria-label="Example availability">
              <table class="availability-table" aria-describedby="availability-caption">
                <thead>
                  <tr><td></td>{availability.days.map((day, index) => <th scope="col"><abbr title={day}>{availability.shortDays[index]}</abbr></th>)}</tr>
                </thead>
                <tbody>
                  {availability.rows.map((row) => (
                    <tr><th scope="row">{row.time}</th>{row.counts.map((count) => <td data-level={count}><span class="sr-only">{count} of 3 available</span><span aria-hidden="true">{count}</span></td>)}</tr>
                  ))}
                </tbody>
              </table>
              </div>
              <figcaption id="availability-caption">{example.exampleLabel}</figcaption>
              <details class="example-help"><summary>{example.readExample}</summary><p>{example.explanation}</p></details>
            </figure>
          )}
          {example.project === 'allotment' && (
            <figure class="sortition-example">
              <ol class="draw-stages">{example.stages?.map((stage) => <li>{stage}</li>)}</ol>
              <div class="table-scroll" role="region" tabindex="0" aria-label="Example panel targets">
              <table class="quota-table">
                <thead><tr><td></td><th scope="col">{example.target}</th><th scope="col">{example.result}</th></tr></thead>
                <tbody>{example.areas?.map((area) => <tr><th scope="row">{area}</th><td>6 seats</td><td>6 seats</td></tr>)}</tbody>
              </table>
              </div>
              <p class="audit-note">{example.audit}</p>
              <figcaption>{example.exampleLabel}</figcaption>
            </figure>
          )}
          {example.project === 'book-power' && (
            <figure class="book-example">
              <div class="book-question"><h3>{example.questionLabel}</h3><p>{example.question}</p></div>
              <div class="book-source"><strong>{example.book}</strong><span>{example.authors}</span></div>
              <div class="book-method"><h3>{example.methodLabel}</h3><code>{example.method}</code><p>{example.explanation}</p></div>
              <figcaption>{example.exampleLabel}</figcaption>
            </figure>
          )}
          <div class="tool-instructions"><p>{example.description}</p><p>{example.note}</p></div>
          <a class="tool-action" href={project.href}>{example.action}<span class="link-line" aria-hidden="true"></span></a>
        </section>
      );
    })}
  </div>
</section>

<script>
  const guide = document.querySelector<HTMLElement>('[data-tool-guide]');
  if (guide) {
    const index = guide.querySelector<HTMLElement>('.tool-index')!;
    const tabs = [...index.querySelectorAll<HTMLAnchorElement>('.tool-choice')];
    const panels = [...guide.querySelectorAll<HTMLElement>('.tool-panel')];
    const narrow = matchMedia('(max-width: 48rem)');

    function activate(selected: number) {
      tabs.forEach((tab, position) => {
        tab.setAttribute('aria-selected', String(position === selected));
        tab.tabIndex = position === selected ? 0 : -1;
        panels[position].hidden = position !== selected;
      });
    }

    index.setAttribute('role', 'tablist');
    const orient = () => {
      const stacked = tabs[1].getBoundingClientRect().top > tabs[0].getBoundingClientRect().top + 1;
      index.setAttribute('aria-orientation', narrow.matches && !stacked ? 'horizontal' : 'vertical');
    };
    orient();
    narrow.addEventListener('change', orient);
    new ResizeObserver(orient).observe(index);
    tabs.forEach((tab, position) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[position].id);
      panels[position].setAttribute('role', 'tabpanel');
      panels[position].setAttribute('aria-labelledby', tab.id);
      panels[position].tabIndex = 0;
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        activate(position);
      });
      tab.addEventListener('keydown', (event) => {
        const keys = index.getAttribute('aria-orientation') === 'horizontal' ? ['ArrowLeft', 'ArrowRight'] : ['ArrowUp', 'ArrowDown'];
        let target = position;
        if (event.key === keys[0]) target = (position - 1 + tabs.length) % tabs.length;
        else if (event.key === keys[1]) target = (position + 1) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else if (event.key === ' ') { event.preventDefault(); activate(position); return; }
        else return;
        event.preventDefault();
        activate(target);
        tabs[target].focus();
      });
    });
    const requested = panels.findIndex((panel) => `#${panel.id}` === location.hash);
    activate(requested >= 0 ? requested : 0);
    guide.classList.add('is-enhanced');
  }
</script>
