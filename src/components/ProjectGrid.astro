---
import { projects, siteCopy } from '../data/projects.js';
---
<section class="project-directory wrap section-space" id="what-we-build" aria-labelledby="projects-heading">
  <div class="section-heading">
    <h2 id="projects-heading">{siteCopy.projectsTitle}</h2>
    <p>{siteCopy.projectsIntroduction}</p>
  </div>
    <ul class="project-list">
      {projects.map((p) => (
        <li>
          <p class="project-purpose">{p.purpose}</p>
          <h3><a href={p.href}>{p.name}</a></h3>
          <p class="project-description">{p.blurb}</p>
        </li>
      ))}
    </ul>
</section>
