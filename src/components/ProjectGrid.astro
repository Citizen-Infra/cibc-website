---
import { projects } from '../data/projects.js';
---
<section class="band" id="what-we-build">
  <div class="wrap">
    <h2>What we build</h2>
    <ul class="grid">
      {projects.map((p) => (
        <li class="card">
          <h3 class="card__name"><a href={p.href}>{p.name}</a></h3>
          <p class="card__blurb">{p.blurb}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
