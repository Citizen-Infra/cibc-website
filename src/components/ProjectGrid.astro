---
import { projects, siteCopy } from '../data/projects.js';
---
<section class="project-directory" id="what-we-build" aria-labelledby="projects-heading">
  <div class="wrap">
    <h2 id="projects-heading">{siteCopy.projectsTitle}</h2>
    <ul class="project-list">
      {projects.map((p) => (
        <li>
          <h3 id={`project-${p.id}`}><a href={p.href}>{p.name}</a></h3>
          <details class="project-details">
            <summary aria-describedby={`project-${p.id}`}>{p.purpose}</summary>
            <p class="project-description">{p.blurb}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
