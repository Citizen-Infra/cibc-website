---
import { links } from '../data/links.js';
import { siteCopy } from '../data/projects.js';
const routes = [links.telegram, links.events, links.recordings, links.code];
---
<section class="next-section" id="next" aria-labelledby="next-heading">
  <div class="wrap next-layout">
    <div class="next-intro">
      <h2 id="next-heading">{siteCopy.nextTitle}</h2>
      <p>{siteCopy.nextIntroduction}</p>
      <div class="participation-links"><a class="button button-primary" href={links.join.href}>{links.join.label}</a><a href={links.support.href}>{links.support.label}</a></div>
    </div>
    <ul class="routes">
      {routes.map((l) => (
         <li><a href={l.href}>{l.label}</a><p>{l.description}</p></li>
      ))}
    </ul>
  </div>
</section>
