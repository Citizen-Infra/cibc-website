---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ToolGuide from '../components/ToolGuide.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import NextSteps from '../components/NextSteps.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base
  title="Citizen Infrastructure Builders Club"
  description="We build, learn, and teach how to use modern tools and protocols that serve mutualism and solidarity."
  path="/"
>
  <SiteHeader home={true} />
  <main id="main">
    <Hero />
    <ToolGuide />
    <ProjectGrid />
    <NextSteps />
  </main>
  <SiteFooter />
</Base>
